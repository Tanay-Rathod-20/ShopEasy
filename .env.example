# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# In production, use a long, cryptographically random secret string!
JWT_SECRET=shopeasy_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
DB_PATH=./server/database/shopeasy.db

# Initial Admin Seeding Credentials (Used only during database initialization)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@shopeasy.com
ADMIN_PASSWORD=Admin@12345
