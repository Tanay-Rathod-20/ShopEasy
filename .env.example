# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# In production, specify a secure random secret string of at least 32 characters!
# Example command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Database Configuration
DB_PATH=./server/database/shopeasy.db

# Administrator Credentials (Used during database initialization/seeding)
# In production, specify strong administrator credentials; known demo defaults will be rejected.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPasswordHere123!
